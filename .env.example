# ==============================================================================
# Autonomous Multi-Agent Growth Platform Configuration
# ==============================================================================

# Execution Mode: Set MOCK_MODE=True to test everything end-to-end without real API keys
MOCK_MODE=True

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Telegram Studio HITL Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# LinkedIn API (OAuth 2.0 / Community Management API)
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_AUTHOR_URN=urn:li:person:your_person_id_or_org_id

# Meta Graph API (Facebook Page & Instagram Graph API)
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token_here
META_PAGE_ID=your_facebook_page_id_here
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id_here

# Scheduling Configuration
TIMEZONE=Asia/Dhaka
PUBLISH_WINDOW_START=08:30
PUBLISH_WINDOW_END=11:30
FIRST_COMMENT_DELAY_SECONDS=120

# Database Configuration
DATABASE_PATH=data/growth.db
CHECKPOINT_DB_PATH=data/checkpoints.db
